# Copy only for externally managed PostgreSQL; project setup generates .env.foundation.
APP_DATABASE_URL=postgresql+psycopg://app_user:YOUR_LOCAL_PASSWORD@127.0.0.1:55432/rpa_development
MIGRATION_DATABASE_URL=postgresql+psycopg://migration_user:YOUR_LOCAL_PASSWORD@127.0.0.1:55432/rpa_development
APP_ALLOWED_HOSTS=127.0.0.1,localhost
APP_ALLOWED_ORIGINS=http://127.0.0.1:8766,http://localhost:8766
APP_COOKIE_SECURE=false
